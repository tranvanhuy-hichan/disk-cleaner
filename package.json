{
  "name": "disk-cleaner",
  "productName": "Disk Cleaner",
  "version": "1.1.0",
  "description": "Tìm và dọn rác trên đĩa: node_modules, thư mục build, cache, Docker",
  "main": "main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron . --no-sandbox",
    "scan": "node scanner.js",
    "dist": "electron-builder --linux AppImage"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "vn.makeai.diskcleaner",
    "productName": "Disk Cleaner",
    "files": [
      "main.js",
      "preload.js",
      "scanner.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage"
      ],
      "maintainer": "tvhuy@makeai.vn"
    },
    "artifactName": "DiskCleaner-${version}.${ext}"
  }
}
